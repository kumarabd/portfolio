{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["DEPLOY_PAGES", "NEXT_PUBLIC_BASE_PATH", "NEXT_PUBLIC_API_BASE_URL"],
      "outputs": [".next/**", "out/**", "dist/**", "!.next/cache/**"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
